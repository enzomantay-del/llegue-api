# Local: sin DATABASE_URL usa SQLite en ./data/llegue.db
# NODE_ENV=development

# Producción (Render): obligatorio. Neon / Supabase / Render Postgres.
# Dashboard Render → Environment → DATABASE_URL
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# NODE_ENV=production

# JWT estables: no los cambies en cada deploy (si no, todas las sesiones se caen).
# JWT_SECRET=
# JWT_REFRESH_SECRET=

# Access 7 días, refresh 60 días (se puede achicar/alargar).
# ACCESS_TTL_SEC=604800
# REFRESH_TTL_SEC=5184000

PORT=8787
OTP_DEV_CODE=123456
OTP_EXPOSE_DEV_CODE=false
SEED_FAMILIA=false
INVITE_PUBLIC_BASE_URL=http://localhost:8787
APP_TZ=America/Argentina/Buenos_Aires
